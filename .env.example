# Local development (.env)
DATABASE_URL="postgresql://user:password@localhost:5432/dispatch_ledger"
AUTH_SECRET="generate-a-long-random-string-at-least-32-characters"
# Optional fallback if AUTH_SECRET is unset (legacy)
# JWT_SECRET="local-dev-secret-change-before-production-min-32-chars"
# Production: your deployed URL (Vercel sets this on most projects)
# AUTH_URL="https://your-app.vercel.app"

# Super admin (created on first deploy / db:seed if no account exists for this email)
# Production: required — this email owns the super-admin role and can create admins.
SUPER_ADMIN_EMAIL="admin@dispatch.local"
# Production: required on first deploy when the super-admin account does not exist yet.
# SEED_SUPER_ADMIN_PASSWORD=

# Legacy aliases (optional — SUPER_ADMIN_EMAIL / SEED_SUPER_ADMIN_PASSWORD take precedence)
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=

# Vercel Cron protection (production: required)
# CRON_SECRET=

# Production: use pooled DATABASE_URL for serverless
# Neon example: postgresql://...?pgbouncer=true&connection_limit=1
